{
  "name": "dsh-always-skills",
  "version": "1.0.0",
  "type": "module",
  "description": "配置每次 AI 对话自动加载的常驻 Skill（支持界面多选、按每轮强注入防遗忘、兼容技能加载展示器与实时热生效）",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "prompt-injection",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zt1901/dsh-always-skills.git"
  }
}
